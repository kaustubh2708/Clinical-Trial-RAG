# Copy to .env and fill in. Pick ONE provider block.

# --- Option A: OpenAI (needs an API key) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Pin a dated snapshot in production for reproducibility, e.g. gpt-4o-mini-2024-07-18
LLM_MODEL_NAME=gpt-4o-mini

# --- Option B: local model with Ollama (no key; data never leaves the machine) ---
# ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434        # from Docker: http://host.docker.internal:11434
# OLLAMA_NUM_CTX=8192                           # context window; must fit the whole prompt
# LLM_TIMEOUT_SECONDS=600                       # CPU inference is slow
# MAX_SCREENING_CRITERIA=1                      # one LLM call per criterion: more reliable for small models

# --- Shared LLM settings ---
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_MAX_OUTPUT_TOKENS=2048

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=clinical_protocols
UPLOAD_DIR=./data/raw_protocols
MAX_UPLOAD_MB=20

CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
# Chosen with eval/run_eval.py (see eval/results.md)
MIN_RELEVANCE_SCORE=0.30
MAX_SCREENING_CRITERIA=80

LOG_LEVEL=INFO
